# ================================
# VARIABLES DE ENTORNO — Radio Web
# ================================
# Copia este archivo como .env y completa los valores.
#
# Para DESARROLLO LOCAL:
#   VITE_RADIO_STREAM_URL=http://tu-servidor:puerto/;
#
# Para PRODUCCIÓN EN VERCEL:
#   VITE_RADIO_STREAM_URL=/api/stream
#   (y configura el destino real del proxy en vercel.json → rewrites)
#

# URL del stream de SHOUTcast/Icecast
VITE_RADIO_STREAM_URL=

# Nombre de la emisora
VITE_RADIO_NAME=Mi Radio

# Descripción de la emisora
VITE_RADIO_DESCRIPTION=Tu emisora online de música y entretenimiento
